# Copier en .env (jamais versionné) et adapter.

# Secret de signature des sessions, 32 caractères minimum. Obligatoire en production ;
# en développement, un secret éphémère est généré à chaque démarrage s'il manque.
AUTH_SECRET=

# Adresse publique de l'interface : liens des courriels, adresses canoniques, plan du site.
# APP_URL=http://localhost:5173

# Environnement : developpement, recette ou production (par défaut selon NODE_ENV).
# Hors production, aucune page n'est indexée.
# APP_ENV=developpement

# Envoi des courriels. Sans SMTP_URL, les courriels sont écrits dans storage/mail et la console.
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
# MAIL_FROM=RECTO <ne-pas-repondre@exemple.fr>

# Données : dossier de la base et des sauvegardes (par défaut data/), images traitées, courriels écrits.
# DATA_DIR=./data
# MEDIA_DIR=./storage/media
# MAIL_DIR=./storage/mail

# Base libSQL distante au lieu du fichier local (sauvegardes alors assurées par le fournisseur).
# DATABASE_URL=libsql://recto-exemple.turso.io
# DATABASE_AUTH_TOKEN=

# Sauvegarde quotidienne, trente jours de rétention : on par défaut en production, off sinon.
# BACKUPS=on
# BACKUP_DIR=./data/backups

# Nombre de mandataires inverses devant le serveur (1 par défaut en production).
# TRUST_PROXY=1

# Version renvoyée par /api/health.
# RECTO_VERSION=

# API_PORT=4747
