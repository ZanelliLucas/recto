{
  "name": "@recto/server",
  "version": "0.1.0",
  "private": true,
  "description": "Services applicatifs RECTO : catégories, parties chronométrées côté serveur",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "content:drapeaux": "tsx scripts/drapeaux/generate.ts",
    "content:commons:resolve": "tsx scripts/commons/resolve.ts",
    "content:commons:import": "tsx scripts/commons/import.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed-drapeaux.ts",
    "db:backup": "tsx scripts/backup.ts",
    "user:role": "tsx scripts/user-role.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.2.1",
    "@recto/shared": "*",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "sharp": "^0.35.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13"
  }
}
