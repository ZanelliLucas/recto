# Copier en deploy/.env (jamais versionné) sur le serveur de production.

# Nom de domaine servi par Caddy, sans protocole.
DOMAIN=recto.exemple.fr

# Adresse publique canonique : liens des courriels, adresses canoniques, plan du site.
APP_URL=https://recto.exemple.fr

# production : site indexé. recette : même comportement, mais aucune page indexée.
APP_ENV=production

# 32 caractères minimum ; par exemple : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Courriels de service (vérification d'adresse, réinitialisation du mot de passe).
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
MAIL_FROM=RECTO <ne-pas-repondre@recto.exemple.fr>

# Version affichée par /api/health (par exemple le condensé du commit déployé).
RECTO_VERSION=
